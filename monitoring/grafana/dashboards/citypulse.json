{
  "uid": "citypulse",
  "title": "CityPulse Platform",
  "tags": ["citypulse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest rate (records/s)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(citypulse_ingest_records_total[$__rate_interval]))",
          "legendFormat": "all streams"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(citypulse_http_requests_total[$__rate_interval])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency (p95, seconds)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(citypulse_http_latency_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kafka topics",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "count(kafka_topic_partitions) or vector(0)",
          "legendFormat": "topics"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node CPU",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres connections",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"citypulse\"} or vector(0)",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka message rate (per topic)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(kafka_topic_partition_current_offset[$__rate_interval])) by (topic)",
          "legendFormat": "{{topic}}"
        }
      ]
    }
  ]
}
