# ==========================================================================
# CityPulse - Smart Urban Mobility Data Lake & Analytics Platform
# Environment configuration (copy to .env and adjust)
# ==========================================================================

# --- Object storage (MinIO / S3 compatible) ---
MINIO_ROOT_USER=citypulse
MINIO_ROOT_PASSWORD=citypulse-secret
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=citypulse
S3_SECRET_KEY=citypulse-secret
S3_BUCKET_RAW=warehouse
S3_BUCKET_ARTIFACTS=artifacts
S3_PATH_STYLE_ACCESS=true

# --- PostgreSQL (serving layer + Airflow + dbt metadata) ---
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=citypulse-secret
POSTGRES_DB=citypulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SCHEMA=gold

# --- Apache Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSPORT=raw.transport.vehicle.positions
KAFKA_TOPIC_TRIP_UPDATES=raw.transport.trip.updates
KAFKA_TOPIC_WEATHER=raw.weather.observations
KAFKA_TOPIC_EVENTS=raw.city.events

# --- External data sources (optional, used when API keys are provided) ---
# TransitFeed / GTFS-RT realtime feed URLs (leave blank to use simulator)
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_VEHICLE_POSITIONS_URL=
# Open-Meteo is keyless - used as the default weather source
WEATHER_LAT=52.5200
WEATHER_LON=13.4050
OPEN_WEATHER_API_KEY=
EVENTS_API_KEY=

# --- Spark / Delta Lake ---
SPARK_MODE=client
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
DELTA_CHECKPOINT_BASE=/opt/spark/work-dir/checkpoints
DELTA_TABLE_PREFIX=s3a://warehouse

# --- ML ---
ML_MODEL_PATH=/opt/ml/model/model.joblib
ML_FEATURES_PATH=/opt/ml/model/features.json

# --- FastAPI ---
API_PORT=8000
API_CORS_ORIGINS=*

# --- Grafana / Prometheus ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- City profile (demo simulation parameters) ---
CITY_NAME=Berlin
SIM_UPDATE_INTERVAL_SEC=2
SIM_VEHICLES=40
SIM_RUSH_HOUR_AMPLITUDE=1.6
# Time compression for the Kafka producer (1.0 = realtime)
SIM_FAST_FACTOR=1.0

# --- Airflow ---
# Airflow DAGs orchestrate the batch jobs through the Docker daemon socket;
# the compose project name drives the network/volume names below.
AIRFLOW_FERNET_KEY=dGp5dFZ5UnJuQ0x4NWFkU3R5Z2hrTHZhR2VzV1g2cVRlblhRcXhFdmFURD0=
CITYPULSE_NETWORK=citypulse_default
CITYPULSE_ML_VOLUME=citypulse_ml_artifacts
